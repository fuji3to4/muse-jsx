{
  "name": "muse-jsx",
  "version": "0.3.1",
  "description": "Reconstructed muse-js: Muse EEG Headset JavaScript Library",
  "main": "dist/index.js",
  "module": "dist-esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "repository": "https://github.com/fuji3to4/muse-jsx",
  "author": "Satoshi Fujiii",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run fix-esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "fix-esm": "node scripts/fix-esm-imports.js",
    "build:demo": "vite build",
    "clean": "rimraf dist dist-esm",
    "format": "prettier --write \"src/**/*.ts\" \"**/*.json\"",
    "precommit": "lint-staged",
    "prepare": "npm run build",
    "start": "vite",
    "lint": "eslint src/**/*.ts demo/src/**/*.ts",
    "test": "npm run lint && jest",
    "test:watch": "jest --watch"
  },
  "files": [
    "dist",
    "dist-esm"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neurosity/pipes": "^5.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "baseline-browser-mapping": "^2.11.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-util": "^30.4.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-bluetooth-mock": "^1.2.0"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "test-exclude": "^7.0.2",
    "glob": "^11.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^muse-jsx$": "<rootDir>/src/index.ts"
    },
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": ".",
            "outDir": "dist-test",
            "baseUrl": ".",
            "paths": {
              "muse-jsx": [
                "src/index.ts"
              ]
            }
          }
        }
      ]
    },
    "testMatch": [
      "**/*.spec.ts"
    ]
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
